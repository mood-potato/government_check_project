POSTGRES_HOST=...
POSTGRES_DB=...
POSTGRES_USER=...
POSTGRES_PASSWORD=...
POSTGRES_PORT=...

# Supabase 원격 DB에 적재할 때 사용한다.
# Dashboard > Connect에서 Session pooler 또는 Direct connection 문자열을 복사한다.
# 예: postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=...

OPEN_GOVERMENT_API_KEY=...

# LLM (요약 기능용)
OPENAI_API_KEY=...

# Elasticsearch (벡터 검색용)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

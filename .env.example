POSTGRES_HOST=postgres
POSTGRES_DB=government_project
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Supabase 원격 DB에 적재할 때 사용한다.
# Dashboard > Connect에서 Session pooler 또는 Direct connection 문자열을 복사한다.
# 예: postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=

OPEN_GOVERMENT_API_KEY=...

# LLM (요약 기능용)
OPENAI_API_KEY=...

# Airflow 실패 알림용 Gmail SMTP. 비밀번호는 Google 앱 비밀번호를 사용한다.
AIRFLOW_SMTP_USER=
AIRFLOW_SMTP_PASSWORD=
PIPELINE_ALERT_EMAIL=

# Elasticsearch (벡터 검색용)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Docker 파이프라인 기본 stage:
# speaker-seed,bill-url-workbook,bill-speech,vectorize,contradiction,home
# API 기반 수집까지 실행하려면 예:
# PIPELINE_STAGES=speaker-seed,bill-info,bill-url,bill-speech,vectorize,contradiction,home
PIPELINE_STAGES=
